  <tool name="krm_save_next_version" label="Save Next Version" icon="">
    <helpText><![CDATA[Save the current hip file with its version number incremented by one.]]></helpText>
    <script scriptType="python"><![CDATA[
import importlib.util

# save_next_version.py はロード（exec_module）されたトップレベルで
# save_next_version() を直接呼び出すので、ここで改めて呼ぶ必要はない。
script_path = hou.expandString("$HSITE/houdini22.0/scripts/krm_tool/save_next_version.py")
spec = importlib.util.spec_from_file_location("krm_save_next_version", script_path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
]]></script>
  </tool>
